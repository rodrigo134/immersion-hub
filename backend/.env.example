# Database Configuration
DB_HOST=localhost
DB_PORT=5434
DB_NAME=immersionhub
DB_USERNAME=immersion
DB_PASSWORD=immersion

# Spring Boot Configuration
SERVER_PORT=8080

# Frontend URL used in password reset links
FRONTEND_BASE_URL=http://localhost:5173

# SMTP Configuration (set your provider values)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=app-password-or-smtp-password
# For Gmail SMTP, keep MAIL_FROM equal to MAIL_USERNAME (or a verified alias)
MAIL_FROM=your@email.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_DEBUG=true
